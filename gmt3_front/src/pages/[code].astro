---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/Header.jsx';
import { EventDetail } from '../views/Events/Detail.jsx';

const code = Astro.params.code;
const API_BASE = process.env.API_BASE_INTERNAL || 'http://localhost:3000/api';
const SITE = 'https://gmt3-fianarantsoa.mg';
const PUBLIC_BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'https://gmt3-fianarantsoa.mg';

let event = null;
if (code) {
	event = await fetch(`${API_BASE}/evenements/code/${encodeURIComponent(code)}`, { credentials: 'include' })
		.then((response) => (response.ok ? response.json() : null))
		.catch(() => null);
}

const title = event ? `${event.titre} — GMT3 Fianarantsoa` : 'Événement — GMT3 Fianarantsoa';
const description = event
	? (event.description || '').replace(/[#*_`>]/g, '').slice(0, 160)
	: 'Détail de l’expédition à Fianarantsoa et Haute Matsiatra.';
const ogImage = event?.imagePrincipale ? `${PUBLIC_BACKEND}${event.imagePrincipale}` : undefined;
const eventUrl = `${SITE}/${code}`;
const jsonLd = event
	? {
			'@context': 'https://schema.org',
			'@type': 'TouristTrip',
			name: event.titre,
			description,
			...(ogImage && { image: ogImage }),
			...(event.typeEvenement?.nom && { touristType: event.typeEvenement.nom }),
			provider: { '@id': `${SITE}/#organization` },
			...(event.prix != null && {
				offers: {
					'@type': 'Offer',
					price: event.prix,
					priceCurrency: 'MGA',
					availability: 'https://schema.org/InStock',
					url: eventUrl,
				},
			}),
			url: eventUrl,
		}
	: undefined;
const breadcrumbLd = event
	? {
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
				{ '@type': 'ListItem', position: 2, name: 'Expéditions', item: `${SITE}/events` },
				{ '@type': 'ListItem', position: 3, name: event.titre, item: eventUrl },
			],
		}
	: undefined;
const pageLd = [breadcrumbLd, jsonLd].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout title={title} description={description} image={ogImage} noindex={!event} ogType="article" jsonLd={pageLd} mobileBottomBar={true}>
	<Header client:load />
	<EventDetail client:load params={{ code }} />
</BaseLayout>

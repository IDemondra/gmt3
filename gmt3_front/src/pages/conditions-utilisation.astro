---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/Header.jsx';
import { Footer } from '../components/Footer.jsx';
import { Conditions } from '../components/Conditions.jsx';

const SITE = 'https://gmt3-fianarantsoa.mg';

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: "Conditions d'utilisation", item: `${SITE}/conditions-utilisation` },
	],
};
---

<BaseLayout
	title="Conditions d'utilisation — GMT+3 Fianarantsoa"
	description="Conditions d'utilisation du site GMT+3 Fianarantsoa : réservation et participation aux expéditions, prix et paiement, annulation, avis, données personnelles et droit applicable."
	jsonLd={breadcrumbLd}
>
	<Header theme="light" client:load />
	<Conditions />
	<Footer />
</BaseLayout>

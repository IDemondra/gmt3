---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Header } from '../../components/Header.jsx';
import { EventDetail } from '../../views/Events/Detail.jsx';

const id = Astro.params.id;
// Fetch SSR -> backend interne (runtime), distinct du /api client (navigateur)
const API_BASE = process.env.API_BASE_INTERNAL || 'http://localhost:3000/api';

// Fetch serveur uniquement pour les méta SEO (le rendu visuel = composant existant)
let event = null;
const eventId = parseInt(id ?? '', 10);
if (!Number.isNaN(eventId)) {
	event = await fetch(`${API_BASE}/evenements/${eventId}`, { credentials: 'include' })
		.then((r) => (r.ok ? r.json() : null))
		.catch(() => null);
}

const title = event ? `${event.titre} — GMT3 Fianarantsoa` : 'Événement — GMT3 Fianarantsoa';
const description = event
	? (event.description || '').replace(/[#*_`>]/g, '').slice(0, 160)
	: 'Détail de l’expédition à Fianarantsoa et Haute Matsiatra.';
// Image OG absolue : les uploads sont servis par le backend, pas par le domaine front.
const PUBLIC_BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'https://gmt3-fianarantsoa.mg';
const ogImage = event?.imagePrincipale ? `${PUBLIC_BACKEND}${event.imagePrincipale}` : undefined;
const SITE = 'https://gmt3-fianarantsoa.mg';
const publicEventUrl = event?.publicCode ? `${SITE}/${event.publicCode}` : `${SITE}/events/${id}`;

// L'API renvoie les dates en DD/MM/YYYY -> schema.org exige du ISO 8601.
const toISO = (d: string | null | undefined) => {
	if (!d) return undefined;
	const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(d);
	return m ? `${m[3]}-${m[2]}-${m[1]}` : d;
};

const jsonLd = event
	? {
			'@context': 'https://schema.org',
			'@type': 'TouristTrip',
			name: event.titre,
			description,
			...(ogImage && { image: ogImage }),
			...(event.lieu && {
				touristType: event.typeEvenement?.nom || 'Tourisme à Fianarantsoa',
				itinerary: { '@type': 'Place', name: event.lieu },
			}),
			...(toISO(event.dateDepart) && { startDate: toISO(event.dateDepart) }),
			...(toISO(event.dateRetour) && { endDate: toISO(event.dateRetour) }),
			provider: { '@id': 'https://gmt3-fianarantsoa.mg/#organization' },
			...(event.prix != null && {
				offers: {
					'@type': 'Offer',
					price: event.prix,
					priceCurrency: 'MGA',
					availability: 'https://schema.org/InStock',
					url: publicEventUrl,
				},
			}),
		}
	: undefined;

const breadcrumbLd = event
	? {
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
				{ '@type': 'ListItem', position: 2, name: 'Expéditions', item: `${SITE}/events` },
				{ '@type': 'ListItem', position: 3, name: event.titre, item: publicEventUrl },
			],
		}
	: undefined;

const pageLd = [breadcrumbLd, jsonLd].filter(Boolean);
---

<BaseLayout title={title} description={description} image={ogImage} noindex={!event} ogType="article" jsonLd={pageLd} mobileBottomBar={true}>
	<Header client:load />
	<EventDetail client:load params={{ id }} />
</BaseLayout>

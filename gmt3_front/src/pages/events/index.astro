---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Header } from '../../components/Header.jsx';
import { Events } from '../../views/Events/index.jsx';

const SITE = 'https://gmt3-fianarantsoa.mg';
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Expéditions', item: `${SITE}/events` },
	],
};
---

<BaseLayout
	title="Randonnées & expéditions à Fianarantsoa — GMT3 Fianarantsoa"
	description="Calendrier des randonnées et circuits à Fianarantsoa et en Haute Matsiatra : dates fermes, groupes restreints, immersion culturelle Betsileo. Réservez votre place."
	jsonLd={breadcrumbLd}
>
	<Header client:load />
	<Events client:load />
</BaseLayout>

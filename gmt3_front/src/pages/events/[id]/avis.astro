---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Header } from '../../../components/Header.jsx';
import { Footer } from '../../../components/Footer.jsx';
import { EventReviews } from '../../../views/Events/Reviews.jsx';

export const prerender = false;

const id = Astro.params.id;
const eventId = parseInt(id ?? '', 10);
const API_BASE = process.env.API_BASE_INTERNAL || 'http://localhost:3000/api';

let event = null;
if (!Number.isNaN(eventId)) {
	 event = await fetch(`${API_BASE}/evenements/${eventId}`, { credentials: 'include' })
		.then((response) => (response.ok ? response.json() : null))
		.catch(() => null);
}

const title = event ? `Avis — ${event.titre} | GMT3 Fianarantsoa` : 'Avis événement — GMT3 Fianarantsoa';
const description = event
	? `Découvrez les avis des participants de ${event.titre}.`
	: 'Découvrez les avis des participants aux expéditions GMT3.';
const publicEventUrl = event?.publicCode ? `https://gmt3-fianarantsoa.mg/${event.publicCode}` : `https://gmt3-fianarantsoa.mg/events/${eventId}`;
const publicReviewsUrl = `${publicEventUrl}/avis`;
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://gmt3-fianarantsoa.mg/' },
		{ '@type': 'ListItem', position: 2, name: 'Expéditions', item: 'https://gmt3-fianarantsoa.mg/events' },
		{ '@type': 'ListItem', position: 3, name: event?.titre || 'Avis événement', item: publicReviewsUrl },
	],
};
---

<BaseLayout title={title} description={description} jsonLd={breadcrumbLd}>
	<Header theme="light" client:load />
	<EventReviews eventId={eventId} client:load />
	<Footer />
</BaseLayout>

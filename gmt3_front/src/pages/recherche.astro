---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/Header.jsx';
import { Footer } from '../components/Footer.jsx';
import { isDateInFuture } from '../utils/dateFormatter.js';

const SITE = 'https://gmt3-fianarantsoa.mg';
const API_BASE = process.env.API_BASE_INTERNAL || 'http://localhost:3000/api';
const GOOGLE_CDN = 'https://lh3.googleusercontent.com/';

function resolveImg(url: string): string {
	if (!url) return '';
	if (url.startsWith(GOOGLE_CDN)) return url.replace(GOOGLE_CDN, '/google-img/');
	if (url.startsWith('http') || url.startsWith('blob:')) return url;
	return url; // chemin relatif servi en same-origin (/uploads proxifié)
}

const q = (Astro.url.searchParams.get('q') || '').trim();

let results: any[] = [];
if (q) {
	try {
		const res = await fetch(`${API_BASE}/evenements`);
		if (res.ok) {
			const data = await res.json();
			const list = Array.isArray(data.data) ? data.data : [];
			const needle = q.toLowerCase();
			results = list
				.filter((e: any) => e.estPublie && isDateInFuture(e.dateDepart || e.dateEvenement))
				.filter((e: any) =>
					[e.titre, e.lieu, e.description]
						.filter(Boolean)
						.some((f: string) => f.toLowerCase().includes(needle)),
				);
		}
	} catch {
		results = [];
	}
}

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Recherche', item: `${SITE}/recherche` },
	],
};

const pageTitle = q
	? `Recherche : ${q} — GMT+3 Fianarantsoa`
	: 'Recherche — GMT+3 Fianarantsoa';
---

<BaseLayout
	title={pageTitle}
	description="Recherchez parmi les expéditions, randonnées et circuits de GMT+3 Fianarantsoa en Haute Matsiatra."
	noindex={true}
	jsonLd={breadcrumbLd}
>
	<Header theme="light" client:load />

	<main class="bg-background text-on-background flex-1">
		<section class="w-full max-w-4xl mx-auto px-margin-mobile md:px-margin-desktop pt-32 pb-24">
			<span class="font-label-caps text-label-caps tracking-[0.2em] text-primary">Recherche</span>
			<h1 class="font-h1 text-h1 md:text-5xl font-black uppercase tracking-tighter leading-none mt-3 mb-8">
				Trouver une expédition
			</h1>

			<form method="get" action="/recherche" role="search" class="flex gap-3 mb-12">
				<input
					type="search"
					name="q"
					value={q}
					placeholder="Randonnée, lieu, circuit…"
					aria-label="Rechercher une expédition"
					class="flex-1 rounded-full border border-outline-variant bg-surface-container px-6 py-4 font-body-md text-on-background placeholder:text-on-surface-variant focus:outline-none focus:border-primary"
				/>
				<button
					type="submit"
					class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white px-6 py-4 rounded-full font-button text-xs tracking-widest font-black uppercase transition-colors"
				>
					<span class="material-symbols-outlined text-base">search</span>
					<span class="hidden sm:inline">Chercher</span>
				</button>
			</form>

			{q && (
				<p class="font-body-md text-on-surface-variant mb-8">
					{results.length} résultat{results.length > 1 ? 's' : ''} pour « {q} »
				</p>
			)}

			{q && results.length === 0 && (
				<div class="rounded-2xl border border-outline-variant bg-surface-container px-8 py-16 text-center">
					<span class="material-symbols-outlined text-4xl text-primary mb-4 block">travel_explore</span>
					<p class="font-body-lg font-semibold">Aucune expédition trouvée</p>
					<p class="font-body-md text-on-surface-variant mt-2">
						Essayez un autre mot-clé, ou consultez toutes nos <a href="/events" class="text-primary underline">expéditions</a>.
					</p>
				</div>
			)}

			{results.length > 0 && (
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					{results.map((e: any) => (
						<a
							href={`/events/${e.id}`}
							class="group relative flex flex-col rounded-2xl border border-outline-variant bg-surface-container overflow-hidden transition-all duration-300 hover:border-primary hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1"
						>
							<div class="relative h-48 overflow-hidden">
								{e.imagePrincipale ? (
									<div
										class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-[1.08]"
										style={`background-image: url('${resolveImg(e.imagePrincipale)}')`}
									/>
								) : (
									<div class="absolute inset-0 bg-surface-variant flex items-center justify-center">
										<span class="material-symbols-outlined text-5xl text-on-surface-variant/30">landscape</span>
									</div>
								)}
								<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

								<span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-primary/90 backdrop-blur-sm px-3 py-1.5 font-label-caps text-label-caps text-white shadow-md shadow-black/20">
									<span class="material-symbols-outlined text-[14px]">explore</span>
									Expédition
								</span>

								<div class="absolute bottom-3 left-3 right-3">
									<span class="inline-flex items-center gap-2 rounded-full bg-black/45 backdrop-blur-md border border-white/15 pl-2 pr-4 py-2 shadow-lg shadow-black/30 max-w-full">
										<span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary shrink-0">
											<span class="material-symbols-outlined text-[15px] text-white">location_on</span>
										</span>
										<span class="font-button text-[11px] tracking-wide font-bold text-white uppercase truncate">{e.lieu || 'Haute Matsiatra'}</span>
									</span>
								</div>
							</div>

							<div class="flex flex-col flex-grow p-5">
								<h2 class="font-h3 text-lg font-black uppercase tracking-tight leading-tight clamp-2 group-hover:text-primary transition-colors">
									{e.titre}
								</h2>

								<div class="mt-3 flex items-center gap-1.5 text-primary">
									<span class="material-symbols-outlined text-[17px] shrink-0">map</span>
									<span class="font-body-md font-semibold text-on-background truncate">{e.lieu || 'Haute Matsiatra'}</span>
								</div>

								<div class="mt-auto pt-4 flex items-center justify-between">
									<span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-on-surface-variant tracking-widest uppercase">
										<span class="material-symbols-outlined text-[15px]">calendar_month</span>
										{e.dateDepart || e.dateEvenement || '—'}
									</span>
									<span class="inline-flex items-center gap-1 font-button text-[10px] tracking-widest uppercase text-primary font-black">
										Détails
										<span class="material-symbols-outlined text-[16px] transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
									</span>
								</div>
							</div>
						</a>
					))}
				</div>
			)}
		</section>
	</main>

	<Footer />
</BaseLayout>

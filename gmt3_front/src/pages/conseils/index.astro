---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Header } from '../../components/Header.jsx';
import { Footer } from '../../components/Footer.jsx';

const SITE = 'https://gmt3-fianarantsoa.mg';

const articles = [
	{
		slug: 'que-faire-a-fianarantsoa',
		title: 'Que faire à Fianarantsoa ?',
		excerpt: 'Les 10 incontournables : Haute-Ville historique, train FCE, vignobles, randonnées et artisanat betsileo.',
		icon: 'explore',
	},
	{
		slug: 'randonnee-pays-betsileo',
		title: 'Randonnée en pays Betsileo',
		excerpt: 'Guide pratique : niveaux, itinéraires, équipement, période idéale et conseils de guide local.',
		icon: 'hiking',
	},
	{
		slug: 'quand-partir-a-fianarantsoa',
		title: 'Quand partir à Fianarantsoa ?',
		excerpt: 'Climat des hautes terres, saison sèche, saison des pluies : choisissez la meilleure période.',
		icon: 'calendar_month',
	},
];

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Conseils', item: `${SITE}/conseils` },
	],
};
---

<BaseLayout
	title="Conseils voyage à Fianarantsoa et en Haute Matsiatra | GMT+3"
	description="Guides et conseils pratiques pour préparer votre voyage à Fianarantsoa : que faire, quand partir, randonnées en pays Betsileo et immersion culturelle."
	jsonLd={breadcrumbLd}
>
	<Header client:load />

	<main class="bg-background text-on-background flex-1">
		<section class="w-full max-w-4xl mx-auto px-margin-mobile md:px-margin-desktop pt-32 pb-24">
			<span class="font-label-caps text-label-caps tracking-[0.2em] text-primary">Conseils voyage</span>
			<h1 class="font-h1 text-h1 md:text-5xl font-black uppercase tracking-tighter leading-none mt-3 mb-6">
				Préparez votre voyage
			</h1>
			<p class="font-body-lg text-on-surface-variant leading-relaxed max-w-2xl mb-12">
				Nos guides pratiques pour découvrir Fianarantsoa, la Haute Matsiatra et le pays Betsileo.
			</p>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				{articles.map((a) => (
					<a
						href={`/conseils/${a.slug}`}
						class="group flex flex-col rounded-2xl border border-outline-variant bg-surface-container p-7 transition-all duration-300 hover:border-primary hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1"
					>
						<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-5 group-hover:bg-primary group-hover:scale-110 transition-all duration-300">
							<span class="material-symbols-outlined text-primary group-hover:text-white transition-colors">{a.icon}</span>
						</div>
						<h2 class="font-h3 text-lg font-black uppercase tracking-tight leading-tight group-hover:text-primary transition-colors">
							{a.title}
						</h2>
						<p class="font-body-md text-on-surface-variant leading-relaxed mt-3 flex-grow">{a.excerpt}</p>
						<span class="inline-flex items-center gap-1 font-button text-[10px] tracking-widest uppercase text-primary font-black mt-5">
							Lire le guide
							<span class="material-symbols-outlined text-[16px] transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
						</span>
					</a>
				))}
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

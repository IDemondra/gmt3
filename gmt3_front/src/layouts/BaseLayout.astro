---
import '../index.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/montserrat/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import { ClientRouter } from 'astro:transitions';

const SITE = 'https://gmt3-fianarantsoa.mg';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	mobileBottomBar?: boolean;
}

const {
	title = 'GMT+3 Fianarantsoa | Tourisme, Voyage sur Mesure & Randonnées',
	description = 'GMT3 Fianarantsoa : Spécialiste du tourisme à Fianarantsoa. Circuits, randonnées, voyage sur mesure, immersion culturelle Betsileo et hôtels dans la Haute Matsiatra.',
	image = '/assets/logo_gmt3.jpeg',
	noindex = false,
	ogType = 'website',
	jsonLd,
	mobileBottomBar = false,
} = Astro.props;

const canonical = `${SITE}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${SITE}${image}`;
const isAdmin = Astro.url.pathname.startsWith('/admin');

const organizationLd = {
	'@context': 'https://schema.org',
	'@type': 'TravelAgency',
	'@id': `${SITE}/#organization`,
	name: 'GMT+3 Fianarantsoa',
	alternateName: ['GMT3 Fianarantsoa', 'Great Tours Madagascar'],
	url: SITE,
	logo: `${SITE}/assets/logo_gmt3.jpeg`,
	image: `${SITE}/assets/logo_gmt3.jpeg`,
	description,
	email: 'hanitra@great-madagascar-tours.com',
	telephone: '+261340312401',
	areaServed: 'Madagascar',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Anolaka',
		addressLocality: 'Fianarantsoa',
		addressRegion: 'Haute Matsiatra',
		addressCountry: 'MG',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: -21.4536,
		longitude: 47.0858,
	},
	sameAs: ['https://www.facebook.com/groups/1567275954180870'],
};

// Signal officiel Google pour le "nom du site" affiché dans les résultats.
const websiteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE}/#website`,
	url: SITE,
	name: 'GMT+3 Fianarantsoa',
	alternateName: 'GMT3 Fianarantsoa',
	inLanguage: 'fr',
	publisher: { '@id': `${SITE}/#organization` },
	creator: {
		'@type': 'Person',
		name: 'Demondra',
		url: 'https://www.facebook.com/hajarison.raphael',
	},
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: `${SITE}/recherche?q={search_term_string}`,
		},
		'query-input': 'required name=search_term_string',
	},
};

const structuredData = jsonLd
	? [organizationLd, websiteLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
	: [organizationLd, websiteLd];

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP || '261340312401';
const WHATSAPP_MSG = encodeURIComponent('Bonjour GMT3, je souhaite des informations sur vos expéditions.');
const showWhatsapp = !noindex;

const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html class="light" lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#ba0013" />
		{!isAdmin && <ClientRouter />}
		<link rel="icon" type="image/jpeg" href="/assets/logo_gmt3.jpeg" />
		{/* Le hero est SSR dans le HTML avec fetchpriority="high" : précharger en plus
			les 2 formats faisait doublon et déclenchait un warning "preload not used"
			(le candidat srcset réellement choisi ne correspond pas au href préchargé). */}
		<link rel="dns-prefetch" href="https://lh3.googleusercontent.com" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

		<!-- SEO Local Fianarantsoa -->
		<meta name="geo.region" content="MG" />
		<meta name="geo.placename" content="Fianarantsoa" />
		<meta name="author" content="GMT+3 Fianarantsoa" />
		<meta name="format-detection" content="telephone=no" />

		<!-- Données structurées -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="GMT+3 Fianarantsoa" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="fr_MG" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Fonts — Montserrat/Inter self-hosted via @fontsource (bundle Vite), Material Symbols seule requête Google non-bloquante -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap" rel="stylesheet" />
		</noscript>

		{GA_ID && (
			<>
				<script type="text/partytown" async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script type="text/partytown" is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push(arguments); }
					gtag('js', new Date());
					gtag('config', GA_ID, { send_page_view: false });
					window.addEventListener('load', () => gtag('event','page_view'));
				</script>
			</>
		)}
	</head>
	<body class="bg-background text-on-background font-body-md min-h-dvh flex flex-col">
		<slot />

		{showWhatsapp && (
			<a
				href={`https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`}
				target="_blank"
				rel="noopener noreferrer"
				data-analytics-event="whatsapp_click"
				data-analytics-location="floating"
				aria-label="Contacter GMT3 sur WhatsApp"
				class:list={["group fixed right-5 z-[150] flex items-center gap-3 rounded-full bg-[#25D366] px-4 py-3.5 shadow-lg shadow-black/20 transition-all duration-300 hover:pr-5 hover:scale-105", mobileBottomBar ? "bottom-24 lg:bottom-5" : "bottom-5"]}
			>
				<svg viewBox="0 0 32 32" width="26" height="26" fill="white" aria-hidden="true" class="shrink-0">
					<path d="M16.004 0h-.008C7.174 0 0 7.176 0 16c0 3.5 1.128 6.744 3.046 9.38L1.05 31.33l6.156-1.968A15.9 15.9 0 0 0 16.004 32C24.826 32 32 24.822 32 16S24.826 0 16.004 0Zm9.318 22.594c-.386 1.09-1.92 1.994-3.142 2.258-.836.178-1.928.32-5.604-1.204-4.7-1.948-7.726-6.724-7.962-7.034-.226-.31-1.9-2.53-1.9-4.826s1.168-3.42 1.638-3.89c.386-.386.842-.562 1.122-.562.14 0 .266.007.38.013.328.014.492.034.708.55.27.648.928 2.244 1.006 2.408.08.164.134.356.024.566-.102.21-.192.328-.356.518-.164.19-.346.424-.494.57-.164.164-.336.342-.144.67.19.328.852 1.404 1.83 2.274 1.26 1.122 2.32 1.47 2.69 1.624.276.114.604.086.81-.13.262-.28.586-.744.916-1.2.234-.328.53-.368.84-.252.316.11 1.998.942 2.34 1.112.342.17.568.252.652.394.082.142.082.812-.304 1.902Z"/>
				</svg>
				<span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-bold text-white transition-all duration-300 group-hover:max-w-[140px]">WhatsApp</span>
			</a>
		)}
		<script>
			import { trackEvent } from '../utils/analytics.js';

			document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;
				const link = event.target.closest<HTMLElement>('[data-analytics-event]');
				if (!link) return;
				trackEvent(link.dataset.analyticsEvent, { location: link.dataset.analyticsLocation || 'unknown' });
			});
		</script>
	</body>
</html>
